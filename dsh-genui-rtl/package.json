{
  "name": "dsh-genui-rtl",
  "version": "1.0.0",
  "description": "RTL (Arabic / Persian / Hebrew) fix for the UI components generated by @changfenhuang/dsh-genui (dsh-ui fences, panels, charts, tables, steps, timelines...).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
